var lastHash = '', stops = [];   // stops — координаты колонок, снятые при раскладке
function measure() {
  if (mobile || TEN) return;
  var m = maxScroll();
  rail.style.width = (m ? (strip.scrollLeft / m * 100) : 0).toFixed(2) + '%';
  var x = strip.scrollLeft + 1;
  for (var k = 0; k < stops.length; k++) {
    if (stops[k].r > x) {
      if (stops[k].id !== lastHash) {
        lastHash = stops[k].id;
        history.replaceState(null, '', '#' + stops[k].id);
      }
      return;
    }
  }
}

