-->
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Горизонтальный лонгрид</title>
<link rel="stylesheet" href="/panel.css" />
<style>
  @font-face { font-family: "Even Mono"; font-weight: 400; font-style: normal;
    src: url("/fonts/EvenMono-Regular.woff2") format("woff2"),
         url("/fonts/EvenMono-Regular.woff") format("woff"); font-display: swap; }
  @font-face { font-family: "JetBrains Mono"; font-weight: 400; font-style: normal;
    src: url("/fonts/JetBrainsMono-Regular.woff2") format("woff2"); font-display: swap; }
  /* титул, врезка и заголовок раздела — Dentegra Display той же студии */
  @font-face { font-family: "Dent Display"; font-weight: 400; font-style: normal;
    src: url("/fonts/DentDisplay-Regular.woff2") format("woff2"),
         url("/fonts/DentDisplay-Regular.woff") format("woff"); font-display: swap; }

  /* ── единицы макета ───────────────────────────────────────────────
     --col  базовая колонка (340)      --gut  межколонник (30)
     --pad  поле сверху и снизу (20)   --avail высота ленты
     Пролёт в N колонок = N·col + (N−1)·gut — считается в JS (span()). */
  :root {
    --col: 340px; --gut: 30px; --pad: 30px; --avail: 100vh;
    /* набор: кегль в пикселах при базовой колонке, строка и трекинг — в долях кегля */
    --ttl-lh: 1.17; --ttl-tr: -0.015em;
    --lead-fs: 30px; --lead-lh: 1.3;  --lead-tr: 0.021em;
    --main-fs: 16px; --main-lh: 1.6;  --main-tr: 0.01em;
    --dsc-fs: 11px;  --dsc-lh: 1.6;   --dsc-tr: -0.01em;
    --ub: 1;             /* модуль набора = колонка / 340 (ставится в JS) */
    /* Цвет один на весь макет: набор, индексы, подписи, титул и линии схем.
       Разница веса идёт толщиной штриха и кеглем, а не оттенком.
       Волосяные линии датчиков выведены из него же — подмешаны к фону. */
    --ink: #878C97;      /* серо-синий — единственный цвет макета */
    --bg: #fff;
    --hair: color-mix(in srgb, var(--ink) 30%, var(--bg));
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    background: var(--bg); color: var(--ink);
    font-family: "Even Mono", ui-monospace, monospace;
    overflow: hidden; overscroll-behavior: none;
    -webkit-font-smoothing: antialiased;
  }

  /* ── лента ── */
  #strip {
    position: fixed; inset: 0;
    display: flex; align-items: flex-start; gap: 0;
    padding: var(--pad) 0;
    overflow-x: auto; overflow-y: hidden;
    scrollbar-width: none;
  }
  #strip::-webkit-scrollbar { display: none; }

  .col {
    flex: 0 0 auto; height: var(--avail); width: var(--col);
    margin-right: var(--gut); --u: var(--ub);
  }
  /* Колонки с текстом: не влез по высоте — перетекает в соседнюю.
     Верхнее поле держит место индекса и правку на базовую линию, а сам индекс
     выведен из потока — иначе он занимал бы место только в первой колонке,
     и перетёкшее продолжение начиналось бы выше соседей. */
  .col.flow { position: relative; column-width: var(--col); column-gap: var(--gut);
              column-fill: auto; padding-top: var(--pt, 0px); }
  /* индекс стоит в отведённом ему поле, ширина — покойная мера колонки,
     поэтому он не едет и не участвует в потоке многоколонника */
  /* координаты выведены: верхний левый угол колонки, ширина — покойная мера */
  .col.flow > .idx { position: absolute; top: 0; left: 0; width: var(--col);
                     margin-bottom: 0; }
  /* замерная поза: одна колонка, высота по содержимому */
  .col.flow.gauge { column-width: auto; height: auto; }

  /* ── набор ── */
  .idx {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--dsc-fs) * var(--ub)); line-height: var(--dsc-lh);
    letter-spacing: var(--dsc-tr); color: var(--ink); text-align: center;
    margin-bottom: calc(10px * var(--u)); white-space: pre;
  }
  .idx[data-id] { cursor: pointer; }
  /* индекс кликают ради ссылки — подсказка подчёркиванием, а не цветом:
     цвет в макете один, менять его на наведении нечем */
  .idx[data-id]:hover { text-decoration: underline dotted; text-underline-offset: 4px; }
  .idx.sub { color: var(--ink); margin-bottom: calc(18px * var(--u)); }
  .main { font-size: calc(var(--main-fs) * var(--u)); line-height: var(--main-lh);
          letter-spacing: var(--main-tr); white-space: pre-line; }
  .lead { font-family: "Dent Display", "Even Mono", ui-monospace, monospace;
          font-size: calc(var(--lead-fs) * var(--u)); line-height: var(--lead-lh);
          letter-spacing: var(--lead-tr); }
  /* ссылка: цвета не заводит, отличает её подчёркивание */
  .col a { color: inherit; text-decoration: underline;
           text-underline-offset: .18em; text-decoration-thickness: 1px; }
  .cap  { font-family: "JetBrains Mono", ui-monospace, monospace;
          font-size: calc(var(--dsc-fs) * var(--ub)); line-height: var(--dsc-lh);
          letter-spacing: var(--dsc-tr); color: var(--ink); white-space: pre-line; }
  /* pre-line у тела и подписей: перевод строки в материале — решение автора,
     а не случайность выгрузки. В макете список внутри абзаца («02 – 07») и
     ссылка на страницу в подписи стоят отдельными строками; при обычном
     white-space они схлопывались в пробел, и абзац шёл сплошняком. Пробелы
     pre-line по-прежнему схлопывает, поэтому перенабор не трогается:
     неразрывный пробел под схлопывание не попадает. */
  .nad  { font-family: "JetBrains Mono", ui-monospace, monospace;
          font-size: calc(var(--dsc-fs) * var(--ub)); line-height: var(--dsc-lh);
          letter-spacing: var(--dsc-tr); padding-bottom: calc(6px * var(--u)); }
  .by   { font-family: "JetBrains Mono", ui-monospace, monospace;
          font-size: calc(var(--dsc-fs) * var(--ub)); line-height: var(--dsc-lh);
          letter-spacing: var(--dsc-tr); text-align: center; margin-top: calc(20px * var(--u)); }
  .thumb { display: block; width: calc(50px * var(--ub)); height: calc(50px * var(--ub));
           margin-top: calc(20px * var(--u)); }

  /* открывающая раздел колонка: индекс на левом флаге */
  .col.open > .idx { text-align: left; }


  /* ── титул ── */
  /* Титул занимает экран целиком, поэтому боковые поля даёт он сам:
     без них строка упирается в края там, где мера шире экрана. */
  .col.title { text-align: center; padding-left: var(--gut); padding-right: var(--gut); }
  .col.title .idx { margin-bottom: calc(43px * var(--u)); }
  /* мера титула: длину строки держит текст, а не соседи по ленте */
  .col.title h1 { max-width: calc(var(--ttl-mera, 26) * 1ch); margin: 0 auto; }
  .col.title h1 {
    font-family: "Dent Display", "Even Mono", ui-monospace, monospace; font-weight: 400;
    letter-spacing: var(--ttl-tr); line-height: var(--ttl-lh);
    font-size: var(--ttl, 60px); white-space: pre-line;
  }

  /* ── таблица ── */
  .tabl { display: block; }
  .tsh  { font-family: "JetBrains Mono", ui-monospace, monospace;
          font-size: calc(var(--dsc-fs) * var(--ub)); line-height: var(--dsc-lh);
          letter-spacing: var(--dsc-tr);
          padding-bottom: calc(8px * var(--u)); }
  .tabl .tr { display: block; padding: calc(10px * var(--u)) 0;
              border-top: 1px solid var(--hair); }
  .tabl .tk { font-family: "JetBrains Mono", ui-monospace, monospace;
              font-size: calc(var(--dsc-fs) * var(--ub)); line-height: var(--dsc-lh);
              letter-spacing: var(--dsc-tr);
              padding-bottom: calc(4px * var(--u)); }
  .tabl .tc { font-size: calc(var(--main-fs) * var(--u)); line-height: var(--main-lh);
              letter-spacing: var(--main-tr); white-space: pre-line; }

  /* ── картинки ── */
  .col.fig .idx, .col.figs .idx { margin-bottom: calc(17px * var(--u)); }
  .col.fig img { display: block; width: 100%; height: auto; }
  /* ВАРИАНТЫ СЕТКИ поверх схемы. Оверлей живёт в системе координат самой
     схемы (общий viewBox), поэтому совпадает с ней при любом масштабе.
     Заливка — цвет макета с прозрачностью: своего цвета у подсветки нет. */
  .pole { position: relative; display: block; }
  /* координаты выведены: оверлей растянут по коробке схемы, своих нет */
  /* Варианты сетки берут цвет макета, а не свой: второго цвета в макете
     нет, и вводить его ради подсветки незачем — хватает прозрачности. */
  .vary { position: absolute; inset: 0; width: 100%; height: 100%;
          pointer-events: none; color: var(--ink); }
  .vary > g { opacity: 0; transition: opacity var(--var-ms, 180ms) linear; }
  .vary > g.on { opacity: var(--var-sila, .11); }
  /* линейка зон: шесть равных долей поля, засечка на каждой границе */
  .lineyka { display: flex; margin-top: calc(17px * var(--u));
             height: calc(11px * var(--u));
             border-right: 1px solid currentColor; }
  .lineyka > span { flex: 1; position: relative; display: flex;
                    align-items: center; justify-content: center;
                    border-left: 1px solid currentColor;
                    font-family: "JetBrains Mono", ui-monospace, monospace;
                    font-size: calc(var(--dsc-fs) * var(--ub)); line-height: 1; }
  body.mob .vary { display: none; }

  /* Раскрытие картинки идёт МАСКОЙ: содержимое стоит в натуральную величину,
     открывается сверху вниз нижним краем маски. Не сжатие — при сжатии видно
     всё изображение сплющенным, и это читается как «разворачивается», а нужно
     «открывается». Режет clip-path, а не высота коробки: высота в потоке не
     меняется, поэтому раскрытие не двигает соседей и не дёргает ход стопки. */
  .draw { display: block; width: 100%; aspect-ratio: var(--ar); }
  .draw svg { display: block; width: 100%; height: 100%; }
  .scroller .draw + .draw { margin-top: calc(54px * var(--u)); }
  /* окно колонки со своей вертикальной прокруткой */
  .win { position: relative; height: var(--room, auto); }
  .scroller { height: 100%; overflow-y: auto; overflow-x: hidden;
              scrollbar-width: none; overscroll-behavior: contain; }
  .scroller::-webkit-scrollbar { display: none; }
  /* Выбег: после последней картинки стопка крутится ещё на заданную долю
     высоты ленты. Последняя картинка успевает встать в полный рост и
     побыть одна, а не упирается в конец ровно в тот момент, когда пришла. */
  .scroller .vybeg { display: block; height: var(--vybeg, 0px); }
  body.mob .scroller .vybeg { display: none; }
  /* ── ход ленты ── */
  /* щуп стоит вне видимости, координаты берутся замером и в раскладке не участвуют */
  #probe { position: absolute; top: 0; left: 0; width: 200px; visibility: hidden;
           pointer-events: none;
           /* модуль набора объявлен на колонке — щупу его надо повторить,
              иначе кегли в нём падают к запасному значению и замер врёт */
           --u: var(--ub); }
  #probe .bl { display: inline-block; width: 0; height: 0; vertical-align: baseline; }
  #rail { position: fixed; left: 0; right: 0; bottom: 0; height: 1px; background: var(--hair); }
  #rail i { display: block; height: 100%; width: 0; background: var(--ink); }
  #toast { position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%);
           font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px;
           color: #fff; background: #1a1a1a; padding: 6px 12px; border-radius: 20px;
           opacity: 0; pointer-events: none; transition: opacity .2s; }
  #toast.on { opacity: 1; }

  /* ── отладка ── */
  body.dbg .col { outline: 1px dashed rgba(39,73,176,.35); outline-offset: 0; }
  body.dbgbuf .col.buffer { background: #D9D9D9; height: 200px; }

  /* ── мобайл: те же колонки, только друг под другом ── */
  html.mob, body.mob { height: auto; overflow: visible; }   /* в мобайле крутится сам документ */
  body.mob #strip { position: static; display: block; overflow: visible;
                    height: auto;
                    /* поле сбоку — не второе число, а то же, которым живёт
                       колонка: --pole ставит layoutMob из (экран − COL) / 2 */
                    padding: var(--gap-big, 0px) var(--pole, 20px) var(--pad); }
  body.mob .col { width: auto !important; height: auto !important;
                  column-width: auto !important; margin-right: 0 !important; }
  /* межколонник, поставленный на попа: обычная отбивка между колонками */
  body.mob .col + .col { margin-top: var(--gut); }
  /* ИНДЕКС В МОБАЙЛЕ СТОИТ В ПОТОКЕ. Из потока он выведен ради двух вещей
     сразу: перетекания (в колонке-многоколоннике строка индекса заняла бы
     место только в первой колонке, и продолжение начиналось бы выше) и
     сопряжения по базовой линии — место под индекс держит верхнее поле
     колонки, одно на всех соседей. В мобайле нет ни того, ни другого:
     многоколонника нет, соседей сбоку нет, сопрягать не с кем. Значит
     держать место полем незачем — индекс встаёт обычной строкой и держит
     его сам. Верхнее поле снимается в layoutMob, иначе колонка получила бы
     двойной отступ. // без ручки */
  body.mob .col.flow > .idx { position: static; width: auto;
                              margin-bottom: calc(10px * var(--u)); }
  /* буфер сам и есть пропуск — его высота работает без надбавок */
  body.mob .col.buffer { height: var(--gap-h) !important; margin-top: 0 !important; }
  body.mob .col.buffer + .col { margin-top: 0 !important; }
  body.mob .win { height: auto !important; }
  body.mob .scroller { height: auto !important; overflow: visible; }
  body.mob .scroller figure + figure, body.mob .scroller img + img,
  body.mob .scroller .draw + .draw { margin-top: var(--gut); }
  body.mob #rail { display: none; }

  /* ── каталог статей ──────────────────────────────────────────────
     Строка каталога — окно на уменьшенную ленту. Подрезка снизу идёт
     overflow, а не правкой высот: раскладка не трогается, перенос
     остаётся чистым, и бесшовность перехода не страдает. */
  #teni { position: fixed; inset: 0; visibility: hidden; pointer-events: none;
          overflow: hidden; z-index: -1; }
  /* место сборки соседней статьи повторяет ленту: те же поля и та же
     раскладка, иначе замер набора соврёт */
  .ten-lenta { position: absolute; inset: 0; display: flex; align-items: flex-start;
               padding: var(--pad) 0; overflow: hidden; }
  #ryady { position: fixed; inset: 0; overflow: hidden; z-index: 2;
           pointer-events: none; opacity: 0; }
  body.kat #ryady { pointer-events: auto; opacity: 1; }
  /* фон непрозрачный: им же строка подрезает то, что торчит из соседней */
  .ryad { position: absolute; left: 0; top: 0; width: 100vw;
          overflow: hidden; background: var(--bg); }
  .ryad > .para { display: flex; align-items: flex-start; transform-origin: 0 0; }
  .klon { flex: 0 0 auto; display: flex; align-items: flex-start; }
  /* лента в каталоге — картинка, а не текст: курсором по ней не ведут */
  body.kat #strip { pointer-events: none; }
  /* РАСПАХНУТАЯ ЛЕНТА. В статье #strip — контейнер с прокруткой, и он
     обрезает ленту по экрану: уменьшить такой контейнер значит показать
     тот же обрезок мельче. В каталоге лента распахивается — обрезка
     снимается, а вести её начинает перенос вместо прокрутки. Подмена
     незаметна: в миг подмены перенос равен снятой прокрутке. */
  #strip.raspah { overflow: visible; }
  body.kat #rail  { display: none; }

  /* ── каталог в мобайле: те же правила на переставленных осях ────────
     Ряд идёт вдоль чтения (сверху вниз), ряды стоят поперёк него (слева
     направо). Ряд остаётся «ряд»: род колонки от оси не зависит. */
  body.mob .ryad { width: auto; height: 100vh; }
  body.mob .ryad > .para { display: block; }
  /* кольцо в мобайле: копия отбивается от конца статьи тем же межколонником,
     поставленным на попа (приём 19, воздух одной природы). Отбивка стоит
     МЕЖДУ концом и началом, а не перед первым: у первой копии в ряду ей не
     от чего отбиваться, и, схлопнувшись наружу, она сдвинула бы весь ряд
     мимо замера — ошибка невидимая, потому что раскладка от неё верна. */
  body.mob .klon { display: block; }
  body.mob .col + .klon, body.mob .klon + .klon { margin-top: var(--gut); }
  /* место сборки в тени повторяет ленту и здесь — иначе замер набора соврёт */
  body.mob .ten-lenta { display: block;
                        padding: var(--gap-big, 0px) var(--pole, 20px) var(--pad); }
  /* ЗАМЕРШИЙ ДОКУМЕНТ. На десктопе прокрутку ленты подменял перенос, и ради
     этого распахивался #strip. В мобайле крутится сам документ — значит
     замирает он: тело встаёт в экран, а ленту ведёт тот же перенос. В миг
     подмены перенос равен снятой прокрутке, поэтому подмена не видна.
     Возврат прокрутки на место — в katTickMob, там же, где снят перенос. */
  body.mob.kat { position: fixed; inset: 0; overflow: hidden; }
  body.mob.kat, body.mob.kat #ryady { touch-action: none; }

  /* Крестик: закрыть статью. Стоит на середине нижнего края — на той же
     вертикали, по которой в каталоге встаёт титул: кнопка ждёт там, куда
     статья уедет. В углу её было не видно, потому что волосяная обводка на
     белом не держит края; поэтому крестик залит цветом макета, а сам знак
     набран цветом бумаги. Второго цвета не заводится: те же два.
     Служебная геометрия интерфейса, числа в настоящих пикселах законны. */
  #krest { position: fixed; left: 50%; transform: translateX(-50%);
           bottom: 22px; z-index: 4;
           width: 44px; height: 44px; padding: 0; border-radius: 50%;
           border: 0; background: var(--ink); color: var(--bg);
           cursor: pointer; display: grid; place-items: center;
           /* прозрачность ведёт доля перехода, а не переход CSS: двое на
              одном свойстве не уживаются // без ручки */
           transition: background .18s; }
  #krest:hover { background: color-mix(in srgb, var(--ink) 78%, var(--bg)); }
  #krest svg { display: block; width: 13px; height: 13px; }
  /* В мобайле крестик стоит на середине ПРАВОГО края — на той же
     горизонтали, по которой в каталоге встаёт титул, и с той стороны,
     откуда приходят соседние статьи. Правило то же, что на десктопе
     («кнопка ждёт там, куда статья уедет»), оси переставлены вместе
     с каталогом. */
  body.mob #krest { left: auto; right: 16px; bottom: auto; top: 50%;
                    transform: translateY(-50%); }

  /* Кнопка языка — рядом с шестернёй и её же видом: орган управления берётся
     у панели, свой стенд не заводит (свод, алфавит). Служебная геометрия. */
  .lang-btn { left: 56px;
              font: 600 11px/1 -apple-system, "Helvetica Neue", Arial, sans-serif;
              letter-spacing: .04em; }
</style>
</head>
<body>
<div id="strip" lang="en"></div>
<!-- щуп базовой линии: нулевой строчный блок по базовой линии показывает,
     где она проходит внутри строки каждого стиля. Считать это из метрик
     шрифта нельзя — у трёх гарнитур свои ascender и descender. -->
<div id="probe" aria-hidden="true"><p class="main"><i class="bl"></i>H</p><p class="lead"><i class="bl"></i>H</p><p class="cap"><i class="bl"></i>H</p></div>
<!-- тень: здесь собираются ленты соседних статей для строк каталога.
     Собирать их в самой ленте нельзя — читатель увидел бы, как она
     пересобирается у него под руками. -->
<div id="teni" aria-hidden="true"></div>
<div id="rail"><i></i></div>
<button id="krest" type="button" aria-label="Закрыть статью — в каталог">
  <svg viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.2"
       aria-hidden="true"><path d="M1 1l11 11M12 1L1 12"/></svg>
</button>
<div id="toast">ссылка скопирована</div>

<script src="/gorizont-data.js"></script>
<script src="/gorizont-ru.js"></script>
<script src="/gorizont-prostranstvo.js"></script>
<script src="/gorizont-pyat-slov.js"></script>
<script src="/gorizont-vaib-koding.js"></script>
<script src="/panel.js"></script>
<!-- органы панели из библиотеки /panel-lib (каталог: стенды.0снова.рф/panel-lib) -->
<script src="/panel-lib/segment.js"></script>
<script src="/panel-lib/toggle.js"></script>
<script src="/panel-lib/koridor.js"></script>
<script src="/panel-lib/para.js"></script>
<script src="/panel-lib/palitra.js"></script>
<script src="/panel-lib/otkat.js"></script>
<script src="/panel-lib/datchik.js"></script>
<script src="/panel-lib/maska.js"></script>
<script>
/* Закон стенда — в шапке файла (комментарий над <html>).
   Ниже — параметры, раскладка и ход. */

var DEFAULTS = {
  colDolya: 30,    // колонка: доля экрана, %
  col: [260, 400], // коридор колонки, px
  mod: [90, 125],  // коридор модуля набора, % (100 — базовая колонка 340)
  gut: 34,         // межколонник при базовой колонке, px
  pad: 25,         // поле сверху и снизу при базовой колонке, px
  wheel: 95,       // ход колеса, %
  lag: 80,         // инерция, %
  snap: false,     // притяжение к краю колонки
  wake: 150,       // пауза, после которой колонка отдаёт колесо себе, мс
  naborPath: 620,  // путь набора: за сколько пикселов хода текст собирается, 0 — выключено
  naborFront: 25,  // фронт перебора, % длины строки
