/* ══ КАТАЛОГ СТАТЕЙ ═══════════════════════════════════════════════════
   Каталог — та же лента, свёрнутая в кольцо и разрезанная по титулу.
   Кольцо делается копией, приставленной В ХВОСТ ленты: если встать на
   титул копии, слева окажется конец статьи, справа — её начало. Приставка
   в хвост не двигает ни одной колонки, поэтому координаты статьи (c.l,
   stops) остаются верными и в каталоге, и после возврата.

   Всё — функция доли перехода k. Это не два состояния с анимацией между
   ними, а одно состояние с параметром: переход обратим, его можно
   прервать на полпути, и никакого «конца анимации», после которого
   состояние переписывается, не существует.

   Адрес ведёт History API: документ тот же, страница не перезагружается,
   поэтому переход бесшовный, а адрес всё-таки другой и кнопка «назад»
   работает. На боевом адресе /gorizont/katalog переписан на /gorizont
   правилом в vercel.json; локально (файл .html) адрес живёт запросом
   ?katalog=1 — путь с папкой на простом файловом сервере не открыть. */
var katK = 0, katCel = 0, katOt = 0, katT0 = 0, katDvig = false;
var katS0 = 0, katSdvig = 0, katSled = false, katGryaz = true;
var katSlot = null, katKolco = null, katRaspah = false;
/* katSdvig — сдвиг вдоль оси, ПОПЕРЁК которой лежат ленты: на десктопе он
   вертикальный (ряды стоят вниз), в мобайле горизонтальный (ряды вбок).
   katMoya — где встанет титул копии своей ленты и какая её точка обязана
   стоять в середине экрана. */
var katMoya = { l: 0, c: 0 };
var katRyad = [];         // строки соседних статей; у своей на месте null
var teni = document.getElementById('teni');

/* ЧТО СХОДИТ НА НЕТ — РЕШАЕТ МЕРА ПОПЕРЁК ЛЕНТЫ. На десктопе ряд каталога
   тонкий: картинка показывает в нём полоску и молчит, подпись без картинки
   пуста, буфер на такой мере уже не виден — все три сходят на нет шириной.
   В мобайле поперёк ленты стоит ВСЯ КОЛОНКА целиком: картинка видна целой и
   говорит, подпись стоит при ней — сходить на нет нечему. Заодно весь
   переход остаётся чистым переносом, без правки размеров в кадре: на
   телефоне это же и есть условие плавности. */
function katSzhat(c) {
  if (mobile) return false;
  var t = c.d.t;
  return t === 'fig' || t === 'figs' || t === 'cap' || t === 'buffer';
}
/* Поле ленты сбоку в мобайле — то же число, которым живёт колонка
   (COL = экран − 2·поле), а не назначенное второй раз. // без ручки */
function katPole() { return Math.max(0, (window.innerWidth - COL) / 2); }
/* ТОЛЩИНА ленты поперёк чтения: на десктопе высота ряда, в мобайле его
   ширина. Крой снимает воздух под коротким текстом — в мобайле его нет,
   поперёк ленты стоит вся колонка, поэтому крой туда и не входит.
   Шаг = толщина + промежуток, одинаково на обеих осях. */
function katShag() {
  var tol = mobile
    ? Math.max(24, COL * P.katMasht / 100)
    : Math.max(40, (window.innerHeight - 2 * PAD) * P.katMasht / 100 * P.katKrop / 100);
  return { tol: tol, shag: tol * (1 + P.katProm / 100) };
}
function katMax() {
  var shag = katShag().shag;
  return mobile
    ? Math.max(0, STATI.length * shag - window.innerWidth + katPole())
    : Math.max(0, STATI.length * shag - window.innerHeight + PAD);
}

/* Копия ленты для каталога: только читаемые колонки и без адресов —
   якорь в ленте один, дубли ломали бы ссылку на фрагмент. */
function katKlonSdelat() {
  var k = el('div', 'klon');
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i];
    if (katSzhat(c)) continue;
    var e = c.el.cloneNode(true);
    e.removeAttribute('id');
    [].forEach.call(e.querySelectorAll('[id]'), function (x) { x.removeAttribute('id'); });
    if (!mobile) e.style.width = c.w1 + 'px';   // в мобайле меру держит CSS
    k.appendChild(e);
  }
  return k;
}
/* Копия обязана снять ленту ПОКАЗАННОЙ. Текст в колонке за экраном стоит
   несобранным — неразрывными пробелами, — а титул и врезки могут быть
   уведены маской. Копия этого не знает и унесёт с собой пустоту, поэтому
   перед съёмом лента доводится до покоя вручную: порядок кадра тут не
   помощник, съём идёт в том же кадре, что и решение открыть каталог. */
function katPokazat() {
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i];
    if (c.txtEl && c.shown !== c.txt) { c.txtEl.textContent = c.txt; c.shown = c.txt; }
    if (c.dsc) for (var k = 0; k < c.dsc.length; k++) {
      var dd = c.dsc[k];
      if (dd.shown !== dd.txt) { dd.el.textContent = dd.txt; dd.shown = dd.txt; }
    }
    if (c.maska) StendMaska.pokazat(c.maska, 1, { sdvig: 0, izing: function (t) { return t; } });
  }
}
/* ГДЕ ВСТАНЕТ ТИТУЛ КОПИИ и какая точка ленты обязана стоять в середине
   экрана. На десктопе это сумма покойных мер: длина ленты СЧИТАЕТСЯ, а до
   середины титула — ещё полэкрана, потому что титул занимает экран целиком.
   В мобайле высоту набора знает только браузер, поэтому длина СНИМАЕТСЯ —
   один раз на сборку каталога, не в кадре (П3, то же исключение, что и у
   замера набора); середина титула берётся его собственной высотой, а не
   экраном: в мобайле титул экрана не занимает. */
function katDlina(klon) {
  if (mobile) {
    /* Титул ищется по роду колонки, а не по её месту: перед ним может стоять
       буфер, и тогда первой в копии окажется пустота. Меры берутся у самого
       титула — offsetTop у него и у копии считается от одного и того же
       предка, поэтому вычитать ничего не надо. */
    var t = klon.querySelector('.title');
    var l = klon.offsetTop;
    return { l: l, c: t ? t.offsetTop + t.offsetHeight / 2 : l };
  }
  var w = 0;
  for (var j = 0; j < cols.length; j++) if (!katSzhat(cols[j])) w += cols[j].w1 + GUT;
  return { l: w, c: w + window.innerWidth / 2 };
}

/* СОСЕДНЯЯ СТАТЬЯ СОБИРАЕТСЯ В ТЕНИ. Строка каталога — не картинка статьи,
   а сама её лента, только мелко: значит её надо по-настоящему собрать и
   разложить. Делать это в живой ленте нельзя — читатель увидел бы, как она
   пересобирается под руками. Поэтому движок на время переключается на
   другую статью и другое место, а потом возвращается: всё, что принадлежит
   статье, это шесть величин, и подмены их достаточно. */
function sobratVTeni(st) {
  var mesto = el('div', 'ten-lenta');
  teni.appendChild(mesto);
  var bylo = { st: STATYA, cols: cols, wins: wins, strip: strip, ten: TEN };
  STATYA = st; cols = []; wins = []; strip = mesto; TEN = true;
  build(); layout(); katPokazat();
  /* Мера соседа на десктопе считается прямо тут, в тени: она сумма покойных
     мер и места сборки не спрашивает. В мобайле её надо снять с готового
     ряда, поэтому там она берётся позже — сборка в тени детали не мерит. */
  var klon = katKlonSdelat();
  var res = { klon: klon, m: mobile ? null : katDlina(klon) };
  STATYA = bylo.st; cols = bylo.cols; wins = bylo.wins;
  strip = bylo.strip; TEN = bylo.ten;
  mesto.remove();
  return res;
}

/* Строки каталога: у каждой статьи своя, у текущей ею работает сама лента. */
function katSobrat() {
  katPokazat();
  var svoy = katKlonSdelat();
  if (katKolco) katKolco.remove();
  katKolco = svoy.cloneNode(true);
  strip.appendChild(katKolco);                 // кольцо: копия в хвост ленты
  katSlot.textContent = '';
  katRyad = [];
  for (var i = 0; i < STATI.length; i++) {
    if (STATI[i] === STATYA) { katRyad.push(null); continue; }
    var k = sobratVTeni(STATI[i]);
    var ryad = el('div', 'ryad'), para = el('div', 'para');
    para.appendChild(k.klon.cloneNode(true));  // конец статьи — перед титулом
    para.appendChild(k.klon);                  // начало — после него
    if (mobile) para.style.width = COL + 'px';  // мера ряда = мера колонки
    ryad.appendChild(para);
    ryad.dataset.st = STATI[i].slug;
    katSlot.appendChild(ryad);
    katRyad.push({ el: ryad, m: k.m, vtor: k.klon });
  }
  /* Замеры мобайла — последним ходом, когда все ряды уже стоят в документе:
     до этого мерить нечего. Один проход на сборку каталога, не в кадре. */
  katMoya = katDlina(katKolco);
  if (mobile) for (var r = 0; r < katRyad.length; r++) {
    if (katRyad[r]) katRyad[r].m = katDlina(katRyad[r].vtor);
  }
}
/* МЕРА СНЯТА — ЗНАЧИТ ЕЁ НАДО ПОДТВЕРЖДАТЬ. Считанное число живёт само,
   снятое устаревает: приходит гарнитура, встаёт схема — и длина ленты
   становится другой. Пересобирать ради этого каталог незачем, ряды те же;
   перемерить надо только их длину. Отсюда правило: где на десктопе длина
   пересчитывается каждый кадр даром, в мобайле она снимается заново на
   каждой перекладке — и только там. */
function katPromerit() {
  if (!mobile || !katKolco) return;
  katMoya = katDlina(katKolco);
  for (var r = 0; r < katRyad.length; r++) {
    if (katRyad[r] && katRyad[r].vtor) katRyad[r].m = katDlina(katRyad[r].vtor);
  }
}

/* Вернулись в статью — кольцо снимается: иначе за последним буфером
   лежала бы вторая копия статьи, и лента уезжала бы в неё. */
function katKolcoSnyat() {
  if (!katKolco) return;
  katKolco.remove(); katKolco = null; katGryaz = true;
}

function katAdresEst() {
  return /\/katalog\/?$/.test(location.pathname) || /[?&]katalog=1/.test(location.search);
}
/* Адрес: на боевом путь, локально запрос — файловый сервер путей не знает. */
function adres(kat, slug) {
  var p = location.pathname, a;
  if (/\.html$/.test(p) || p === '/') {
    var q = [];
    if (kat) q.push('katalog=1');
    if (slug && slug !== 'setki') q.push('st=' + slug);
    a = p + (q.length ? '?' + q.join('&') : '');
  } else {
    var koren = p.replace(/\/(katalog|[a-z0-9-]+)\/?$/, '') || '/gorizont';
    a = kat ? koren + '/katalog' : (slug && slug !== 'setki' ? koren + '/' + slug : koren);
  }
  try { history.pushState({ kat: kat ? 1 : 0, st: slug }, '', a); } catch (e) {}
}
function katAdres(v) { adres(v, STATYA.slug); }
function katPusk(v, bezAdresa) {
  v = v ? 1 : 0;
  if (v === katCel) return;
  // откуда уезжаем: на десктопе прокрутка ленты, в мобайле прокрутка документа
  if (v) { katS0 = mobile ? (window.pageYOffset || 0) : strip.scrollLeft; ride = null; }
  katCel = v; katOt = katK; katT0 = performance.now(); katDvig = true;
  if (!bezAdresa) katAdres(v);
}

/* КАТАЛОГ В МОБАЙЛЕ — ТОТ ЖЕ ЗАКОН НА ПЕРЕСТАВЛЕННЫХ ОСЯХ. Вдоль чтения
   теперь вертикаль, поперёк — горизонталь; величины те же.
   Одна точка ленты ведёт всё и по вертикали: она едет от места, где стоял
   читатель, к середине титула копии и обязана всё время стоять в середине
   экрана. При q = 0 перенос равен −katS0 при масштабе 1 — ровно та картинка,
   которую давала прокрутка документа, поэтому подмена не видна.
   По горизонтали своя лента садится в свой ряд каталога.
   Ничто не сходит на нет (см. katSzhat), поэтому здесь переход — чистый
   перенос: ни одного размера, посчитанного в кадре. */
function katTickMob(q, s, mash, moy, g, vw, vh) {
  /* Точка, стоящая в середине экрана, — доля между двумя своими концами:
     при q = 0 это середина того экрана, где читатель остановился, при q = 1
     середина титула копии. Ни одного слагаемого сверх этих двух: половина
     экрана уже сидит внутри katS0-конца и второй раз не прибавляется. */
  var A = katS0 + vh / 2, C = A + (katMoya.c - A) * q;
  if (q > 0) {
    strip.style.transformOrigin = '0 0';
    strip.style.transform =
      'translate(' + (q * (moy * g.shag - katSdvig)).toFixed(2) + 'px,'
      + (vh / 2 - C * s).toFixed(2) + 'px) scale(' + s.toFixed(4) + ')';
  } else if (strip.style.transform) {
    /* Тело разморожено снятым классом — ставим прокрутку туда, где она была.
       Чтение scrollHeight между двумя ходами — принудительный пересчёт: без
       него браузер вернул бы прокрутку по старой, ещё замершей раскладке. */
    strip.style.transform = '';
    void document.documentElement.scrollHeight;
    window.scrollTo(0, katS0);
  }
  for (var r = 0; r < katRyad.length; r++) {
    var rr = katRyad[r];
    if (!rr) continue;
    var x = katPole() * s + r * g.shag - katSdvig + (1 - q) * vw * 0.35;
    rr.el.style.width = g.tol.toFixed(1) + 'px';
    rr.el.style.transform = 'translateX(' + x.toFixed(2) + 'px)';
    rr.el.style.opacity = q;
    rr.el.firstChild.style.transform =
      'translateY(' + (vh / 2 - (rr.m ? rr.m.c : 0) * mash).toFixed(2) + 'px) scale('
      + mash.toFixed(4) + ')';
  }
}

function katTick() {
  var now = performance.now();
  if (katDvig) {
    var t = P.katMs > 0 ? (now - katT0) / P.katMs : 1;
    if (t >= 1) { t = 1; katDvig = false; }
    katK = katOt + (katCel - katOt) * evalEase(P.katEase, P.katBez, t);
  }
  if (katK === 0 && !katSled) return;        // в статье каталог кадра не тратит
  katSled = katK > 0;                        // ещё проход — вернуть всё на место
  var q = katK, vw = window.innerWidth, vh = window.innerHeight;
  var mash = P.katMasht / 100, s = 1 + (mash - 1) * q;
  document.body.classList.toggle('kat', q > 0);
  krest.style.opacity = 1 - q;
  krest.style.pointerEvents = q > 0.5 ? 'none' : '';

  if (!katSlot) { katSlot = el('div'); katSlot.id = 'ryady'; document.body.appendChild(katSlot); }
  /* Пересборка идёт только на ВХОДЕ (katCel > 0). На выходе ряды доживают
     переход теми же, какими были: собирать заново то, что сейчас погаснет,
     значит положить сборку всех статей ровно в тот кадр, где идёт движение. */
  if (q > 0 && katCel > 0 && (katGryaz || !katKolco)) { katSobrat(); katGryaz = false; }
  if (q === 0) { katKolcoSnyat(); }
  var moy = nomerStati(STATYA);              // в каком ряду стоит своя лента
  if (mobile) { katTickMob(q, s, mash, moy, katShag(), vw, vh); return; }

  /* 1. нечитаемые колонки сходят на нет; заодно считается ширина ленты —
        она же координата титула копии, приставленной в хвост */
  var w = 0;
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i], d = katSzhat(c) ? (1 - q) : 1;
    if (c.katD !== d) {
      c.katD = d;
      if (katSzhat(c)) {
        c.el.style.width = (c.w1 * d) + 'px';
        c.el.style.marginRight = (GUT * d) + 'px';
        c.el.style.opacity = d;
      }
    }
    w += (c.w1 + GUT) * d;
  }
  /* 2–3. Одна точка ленты ведёт всё: она едет от середины экрана читателя
        к середине титула копии (w + vw/2) и обязана всё время стоять в
        середине экрана. Отсюда перенос: tx = vw/2 − X·s. При q=0 это ровно
        −katS0 при масштабе 1, то есть та же картинка, что и с прокруткой,
        поэтому подмена прокрутки переносом не видна. По вертикали лента
        садится в свою строку каталога. */
  var g = katShag();
  var X = katS0 + vw / 2 + (w - katS0) * q;
  if (q > 0) {
    if (!katRaspah) { katRaspah = true; strip.classList.add('raspah'); strip.scrollLeft = 0; }
    strip.style.transformOrigin = '0 0';
    strip.style.transform = 'translate(' + (vw / 2 - X * s).toFixed(2) + 'px,'
      + (q * (moy * g.shag - katSdvig)).toFixed(2) + 'px) scale(' + s.toFixed(4) + ')';
  } else {
    if (katRaspah) { katRaspah = false; strip.classList.remove('raspah'); }
    strip.style.transform = '';
    cur = tgt = katS0; strip.scrollLeft = katS0;
  }
  /* 4. соседние статьи всплывают снизу. У каждой своя ширина ленты, значит
        и свой сдвиг: титул копии обязан встать в середину экрана. */
  for (var r = 0; r < katRyad.length; r++) {
    var rr = katRyad[r];
    if (!rr) continue;
    var y = PAD * s + r * g.shag - katSdvig + (1 - q) * vh * 0.35;
    rr.el.style.height = g.tol.toFixed(1) + 'px';
    rr.el.style.transform = 'translateY(' + y.toFixed(2) + 'px)';
    rr.el.style.opacity = q;
    rr.el.firstChild.style.transform =
      'translateX(' + (vw / 2 - rr.m.c * mash).toFixed(2) + 'px) scale('
      + mash.toFixed(4) + ')';
  }
}

var krest = document.getElementById('krest');
krest.addEventListener('click', function () { katPusk(true); });
/* ОТКРЫТЬ СТАТЬЮ ИЗ КАТАЛОГА. Строка каталога и лента статьи — одно и то же
   содержимое в разной мере, поэтому открыть статью значит ПОДМЕНИТЬ строку
   лентой в той же геометрии и погнать долю обратно. Подмена не видна:
   подменяется одинаковое на одинаковое. */
function katOtkryt(slug) {
  var st = statyaPo(slug);
  if (st === STATYA) { katPusk(false); return; }
  var idx = nomerStati(st);
  STATYA = st;
  strip.textContent = ''; cols.length = 0; wins.length = 0;
  katKolco = null;
  build(); layout(); katPokazat();
  katKolco = katKlonSdelat(); strip.appendChild(katKolco);
  katMoya = katDlina(katKolco);    // лента другая — и титул копии встанет иначе
  if (katRyad[idx]) katRyad[idx].el.style.display = 'none';
  katGryaz = true;                 // строки пересоберутся к следующему разу
  katS0 = 0;                       // статья открывается с титула
  strip.lang = LANG;
  katCel = 0; katOt = katK; katT0 = performance.now(); katDvig = true;
  adres(false, slug);
}
/* КАТАЛОГ ЛИСТАЕТСЯ ПАЛЬЦЕМ. В статье вертикаль ведёт сам документ; в
   каталоге он замер, а статьи стоят поперёк чтения — значит и тянуть их
   надо поперёк. Ход идёт за пальцем один в один: кривой тут вести нечего,
   это не появление, а прямое движение руки. Порог отделяет тягу от
   нажатия — рука, сдвинувшая ряды, статью не открывает. // без ручки */
var katPal = null, katTyanul = 0, KAT_POROG = 8;
document.addEventListener('pointerdown', function (e) {
  if (!mobile || !katK || katDvig) return;
  if (e.target.closest && (e.target.closest('.st-panel') || e.target.closest('.st-gear'))) return;
  katPal = { x: e.clientX, y: e.clientY, s: katSdvig };
  katTyanul = 0;
});
document.addEventListener('pointermove', function (e) {
  if (!katPal) return;
  var dx = katPal.x - e.clientX;
  katTyanul = Math.max(katTyanul, Math.abs(dx), Math.abs(katPal.y - e.clientY));
  katSdvig = Math.max(0, Math.min(katMax(), katPal.s + dx));
});
document.addEventListener('pointerup', function () { katPal = null; });
document.addEventListener('pointercancel', function () { katPal = null; katTyanul = 0; });

document.addEventListener('click', function (e) {
  if (!katK || katDvig) return;
  if (katTyanul > KAT_POROG) { katTyanul = 0; return; }   // это была тяга, не выбор
  if (e.target.closest && (e.target.closest('.st-panel') || e.target.closest('.st-gear'))) return;
  var r = e.target.closest && e.target.closest('.ryad');
  if (r && r.dataset.st) { katOtkryt(r.dataset.st); return; }
  katPusk(false);
});
window.addEventListener('popstate', function () {
  var slug = adresStati();
  if (slug !== STATYA.slug && !katAdresEst()) { katOtkryt(slug); return; }
  katPusk(katAdresEst(), true);
});

var sig = '', lastLook = 0;
/* Колонка ожила: набор в ней крупнее, и она же забирает колесо, если ей
   есть куда крутиться. Ограничитель дребезга (П7): пока точка курсора
   внутри уже живой колонки, живой остаётся она — иначе выросшая колонка
   сдвигала бы соседей под неподвижным курсором и они бы перемигивались. */
function setLive(el) {
  if (el === liveCol) return;
  var was = liveCol;
  if (was) was.classList.remove('live');
  liveCol = el;
  if (liveCol) liveCol.classList.add('live');
}
(function watch() {
  var s = [P.colDolya, String(P.col), String(P.mod), P.gut, P.pad, P.mob, P.figFit, P.dbg, P.dbgbuf,
           P.ttlLead, P.ttlTrack, P.leadSize, P.leadLead, P.leadTrack,
           P.mainSize, P.mainLead, P.mainTrack, P.dscSize, P.dscLead, P.dscTrack,
           P.naborPath, P.maskaPath, P.ttlPath, P.fotoPath,
           P.gapBig, P.gapMid, P.gapSml,
           P.bg, P.ink, String(P.ttl), P.ttlSize, P.ttlMera].join(',');
  if (s !== sig) { sig = s; layout(); }
  // В каталоге лента — картинка: текст стоит набранным, вспышка молчит,
  // маски показаны. Это ровно то, чем живёт «меньше движения», поэтому
  // отдельного режима заводить незачем — берётся тот же.
  // Смотрим на НАМЕРЕНИЕ (katCel), а не на достигнутую долю: доля растёт в
  // конце кадра, и на первом кадре после нажатия она ещё ноль. Копии
  // каталога снимаются именно там — по доле они забирали бы колонки
  // за экраном несобранными, то есть пустыми.
  TIHO = TIHO0 || katK > 0 || katCel > 0;
  nabor();
  vspyshka();
  maska();
  stopkaPamyat();     // забыть положение раньше, чем от него считать раскрытие
  raskrytie();
  varyTick();
  katTick();
  var now = performance.now();
  if (!rested()) { setLive(null); lastLook = 0; }
  else if (now - lastLook > 90) {
    lastLook = now;
    if (!(liveCol && mx != null && inside(liveCol, mx))) setLive(colAt());
  }
  requestAnimationFrame(watch);
})();

/* ══ КНОПКА ЯЗЫКА ═════════════════════════════════════════════════════
   Смена языка — ПЕРЕКЛАДКА, а не подмена строк. Русский абзац другой длины
   требует другого числа порций, картинка — другого пролёта, а высота
   набора известна только браузеру: пересчитать это подменой текста нельзя.
   Лента собирается заново, и читателя возвращают на тот фрагмент, где он
   стоял, — адрес фрагмента для того и заведён.
   Орган управления берётся у панели (.st-gear), свой стенд не заводит. */
function perestroit() {
  var yak = lastHash;
  strip.textContent = '';
  cols.length = 0; wins.length = 0;
  katKolco = null; katGryaz = true;          // копии каталога сняты с прежнего языка
  build();
  layout();
  if (yak && document.getElementById(yak)) gotoHash(yak);
  else { cur = tgt = 0; strip.scrollLeft = 0; }
  measure();
}
var langBtn = el('button', 'st-gear lang-btn');
langBtn.type = 'button';
langBtn.setAttribute('aria-label', 'Язык ленты');
function langMetka() {                       // на кнопке — язык, в который ведёт
  langBtn.textContent = LANG === 'ru' ? 'EN' : 'RU';
  langBtn.title = LANG === 'ru' ? 'Read in English' : 'Читать по-русски';
}
langBtn.addEventListener('click', function () {
  LANG = LANG === 'ru' ? 'en' : 'ru';
  try { localStorage.setItem(LANG_KEY, LANG); } catch (e) {}
  strip.lang = LANG;
  langMetka();
  perestroit();
});
document.body.appendChild(langBtn);
langMetka();

/* ── пуск ── */
strip.lang = LANG;
build();
