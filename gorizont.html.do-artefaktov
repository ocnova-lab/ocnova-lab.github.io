    var klv = (d.h - (n - 1) * d.mezh) / n;
    for (var i = 0; i < n; i++) for (var j = 0; j < n; j++) {
      var r = document.createElementNS(ns, 'rect');
      r.setAttribute('x', (i * (kl + d.mezh)).toFixed(2));
      r.setAttribute('y', (j * (klv + d.mezh)).toFixed(2));
      r.setAttribute('width', kl.toFixed(2));
      r.setAttribute('height', klv.toFixed(2));
      r.setAttribute('fill', 'currentColor');
      g.appendChild(r);
    }
    sv.appendChild(g);
  }
  return sv;
}
/* линейка зон под схемой: буквы называют доли, засечки их разделяют */
function lineyka(n) {
  var l = el('div', 'lineyka');
  for (var i = 0; i < n; i++) l.appendChild(el('span', null, String.fromCharCode(97 + i)));
  return l;
}

/* ТАБЛИЦА В ЛЕНТЕ. Ширина у неё одна — колонка: широкую таблицу лента не
   берёт вовсе, решение о таких принимается в макете. Отсюда устройство:
   ячейки строки идут не в ряд, а друг под другом — первая меткой в
   моноширинном дескрипторе, вторая набором тела. Строки разделены
   волосяной линией того же цвета, что и весь макет; своего цвета таблица
   не заводит. // без ручки */
function tablicaEl(d) {
  var t = el('div', 'tabl');
  var sh = slovo(d, 'shapka') || [];
  if (sh.length) t.appendChild(el('div', 'tsh', sh.join('  ·  ')));
  (slovo(d, 'telo') || []).forEach(function (r) {
    var tr = el('div', 'tr');
    r.forEach(function (yach, k) {
      tr.appendChild(el('div', k ? 'tc' : 'tk', yach));
    });
    t.appendChild(tr);
  });
  return t;
}

/* ССЫЛКА В ТЕЛЕ. Адрес в материале остаётся адресом: и записанный голым,
   и спрятанный за словами. Цвета ссылка не заводит — цвет в макете один, —
   отличает её подчёркивание. // без ручки */
function abzac(txt, ss) {
  var p = el('p', 'main');
  var meta = [];
  for (var i = 0; i < ss.length; i++) meta.push({ t: ss[i][0], u: ss[i][1] });
  var re = /https?:\/\/[^\s,;)»]+/g, m;
  while ((m = re.exec(txt))) meta.push({ t: m[0], u: m[0] });
  if (!meta.length) { p.textContent = txt; return p; }
  var poz = 0;
  while (poz < txt.length) {
    var kto = null, gde = -1;
    for (var k = 0; k < meta.length; k++) {
      var j = txt.indexOf(meta[k].t, poz);
      if (j >= 0 && (gde < 0 || j < gde)) { gde = j; kto = meta[k]; }
    }
    if (!kto) break;
    if (gde > poz) p.appendChild(document.createTextNode(txt.slice(poz, gde)));
    var a = document.createElement('a');
    a.href = kto.u; a.textContent = kto.t;
    a.target = '_blank'; a.rel = 'noopener';
    p.appendChild(a);
    poz = gde + kto.t.length;
  }
  if (poz < txt.length) p.appendChild(document.createTextNode(txt.slice(poz)));
  p.dataset.ssylki = '1';
  return p;
}

/* окно с прокруткой; полосы хода у него нет — колонка крутится молча */
function win(sc) {
  var w = el('div', 'win');
  w.appendChild(sc);
  w.draw = function () { };
  wins.push(w);
  return w;
}

function build() {
  STATYA.lenta.forEach(function (d, i) {
    var c, id = anchorOf(d);
    switch (d.t) {
      case 'buffer':
        c = el('div', 'col buffer');
        c.dataset.gap = gapLevel(i);
        break;

      case 'title':
        c = el('div', 'col title');
        c.appendChild(idxLine(slovo(d, 'date'), id));
        c.appendChild(el('h1', null, slovo(d, 'text')));
        break;

      case 'lead':
        c = el('div', 'col flow lead-col');
        c.appendChild(idxLine(d.n, id));
        c.appendChild(el('p', 'lead', slovo(d, 'text')));
        // строка автора необязательна: без неё пустой блок съел бы отбивку
        if (slovo(d, 'by')) c.appendChild(el('div', 'by', slovo(d, 'by')));
        break;

      case 'head':
        c = el('div', 'col flow head-col');
        c.appendChild(idxLine(d.n, id));
        // Надстрочник — заголовок второго порядка. Своей колонки он не
        // получает: пустая колонка на одно слово и лишний раздел в
        // нумерации фрагментов дороже, чем строка над словом.
        if (d.nad) c.appendChild(el('div', 'nad', slovo(d, 'nad')));
        c.appendChild(el('p', 'lead', slovo(d, 'text')));
        // вторая строка под заголовком раздела — та же строчная метка, что
        // и строка автора под врезкой: один стиль на одну роль
        if (d.pod) c.appendChild(el('div', 'by', slovo(d, 'pod')));
        break;

      case 'tabl':
        c = el('div', 'col tabl-col');
        c.appendChild(idxLine(d.n, id));
        c.appendChild(tablicaEl(d));
        break;

      case 'cap':
        c = el('div', 'col flow cap-col');
        c.appendChild(idxLine(d.arrow, id));
        c.appendChild(el('p', 'cap', slovo(d, 'text')));
        if (d.thumb) c.appendChild(Object.assign(img(d.thumb, '', 50, 50), { className: 'thumb' }));
        break;

      case 'fig':
        c = el('div', 'col fig');
        c.appendChild(idxLine(d.n, id));
        var one = el('div', 'scroller');
        if (d.varianty) {
          var pole = el('span', 'pole');
          pole.appendChild(d.risuem ? setkaSvg(d) : pic(d.src, 'илл. ' + d.n, d.w, d.h));
          pole.appendChild(varySvg(d));
          one.appendChild(pole);
        } else {
          one.appendChild(pic(d.src, 'илл. ' + d.n, d.w, d.h));
        }
        c.appendChild(win(one));
        if (d.varianty) c.appendChild(lineyka(d.varianty));
        break;

      case 'figs':
        c = el('div', 'col figs');
        if (d.label === 'outside') c.appendChild(idxLine(d.n, id));
        var sc = el('div', 'scroller');
        d.items.forEach(function (it) {
          if (it.n) {
            var f = el('figure');
            f.appendChild(idxLine(it.n).cloneNode(false));
            f.lastChild.className = 'idx sub';
            f.lastChild.textContent = it.n;
            f.appendChild(pic(it.src, 'илл. ' + it.n, it.w, it.h));
            sc.appendChild(f);
          } else {
            sc.appendChild(pic(it.src, 'илл. ' + d.n, it.w, it.h));
          }
        });
        sc.appendChild(el('i', 'vybeg'));
        c.appendChild(win(sc));
        break;

      default:
        c = el('div', 'col flow');
        c.appendChild(idxLine(d.n, id));
        var pp = abzac(slovo(d, 'text'), slovo(d, 'ssylki') || []);
        c.appendChild(pp);
        // перенабирается только тело статьи — и только то, что целиком текст:
        // набор пишет в колонку строкой, а ссылка это объект, и переписать
        // объект строкой значит его потерять
        if (!pp.dataset.ssylki) c.dataset.nabor = '1';
    }
    // вторая часть индекса «00» — колонка открывает раздел; её индекс
    // уходит на левый флаг: метка начала, а не рядовая нумерация
    if (d.n && /–\s*00$/.test(d.n)) c.classList.add('open');
    if (id) c.id = id;
    strip.appendChild(c);
    cols.push({
      el: c, d: d, i: i, r: 0, wNow: -1, kNow: -1, l: 0, rr: 0,
      // перенабор — только моноширинному телу: неразрывный пробел там
      // ровно той же ширины, и разбивка строк не едет
      txtEl: c.dataset.nabor ? c.querySelector('p.main') : null,
      txt: c.dataset.nabor ? slovo(d, 'text') : '', pn: -1, hold: 0, tick: 0, shown: null,
      // границы слов — раз на колонку: текст в ней не меняется, меняется
      // только то, какие слова выбраны вспышкой
      slova: c.dataset.nabor ? slovaIz(slovo(d, 'text')) : null,
      // дескрипторы колонки: индекс, подпись, строка автора — тот же перебор
      // титул живёт маской целиком, перебор его не трогает
      dsc: c.classList.contains('title') ? [] :
        [].map.call(c.querySelectorAll('.idx, .cap, .by'), function (e) {
        return { el: e, txt: e.textContent, shown: null };
      }),
      foto: c.querySelector('img.thumb'),
      // картинки колонки — те, что раскрываются по высоте (портрет подписи не в счёт)
      raskr: [].slice.call(c.querySelectorAll('.scroller img, .scroller .draw')),
      raskrQ: [], raskrY: null, sc: c.querySelector('.scroller'),
      vary: c.querySelector('svg.vary'), varAkt: -2
    });
  });
}

/* ── раскладка ── */
function layout() {
  var vw = window.innerWidth, vh = window.innerHeight;
  mobile = vw < P.mob;
  document.body.classList.toggle('mob', mobile);
  root.classList.toggle('mob', mobile);
  document.body.classList.toggle('dbg', flag(P.dbg));
  document.body.classList.toggle('dbgbuf', flag(P.dbgbuf));
  setka(vw, mobile);
  var u = U;
  root.style.setProperty('--ub', u.toFixed(4));
  root.style.setProperty('--col', COL + 'px');
  root.style.setProperty('--gut', GUT + 'px');
  [['ttl', null, P.ttlLead, P.ttlTrack],
   ['lead', P.leadSize, P.leadLead, P.leadTrack],
   ['main', P.mainSize, P.mainLead, P.mainTrack],
   ['dsc', P.dscSize, P.dscLead, P.dscTrack]].forEach(function (n) {
    if (n[1] != null) root.style.setProperty('--' + n[0] + '-fs', n[1] + 'px');
    root.style.setProperty('--' + n[0] + '-lh', (n[2] / 100).toFixed(4));
    root.style.setProperty('--' + n[0] + '-tr', (n[3] / 100).toFixed(4) + 'em');
  });
  root.style.setProperty('--pad', PAD + 'px');
  root.style.setProperty('--ttl-mera', P.ttlMera);
  root.style.setProperty('--var-sila', (P.varSila / 100).toFixed(3));
  root.style.setProperty('--var-ms', P.varMs + 'ms');
  root.style.setProperty('--vybeg',
    Math.round(Math.max(200, vh - 2 * PAD) * P.vybeg / 100) + 'px');
  ['bg', 'ink'].forEach(function (k) {
    root.style.setProperty('--' + k, P[k]);
  });

  if (mobile) { raskrSnyat(); return layoutMob(vw); }

  /* Базовая линия первой строки — одна на все колонки. Верхнее поле колонки =
     место индекса + поправка на то, где базовая линия проходит внутри строки
     этого стиля. Тогда первые строки соседних колонок стоят на одной линии,
     а перетёкшее продолжение — на той же, что и текст с индексом. */
  var probe = document.getElementById('probe'), bl = {};
  ['main', 'lead', 'cap'].forEach(function (k) {
    var e = probe.querySelector('p.' + k), i = e.querySelector('.bl');
    bl[k] = korobka(i).top - korobka(e).top;
  });
  var LAB = Math.round(P.dscSize * u * P.dscLead / 100 + 10 * u);
  root.style.setProperty('--lab', LAB + 'px');

  var avail = Math.max(200, vh - 2 * PAD);
  // строка индекса по фактическому набору + отбивка 17, всё в модуле
  var lab = Math.round((P.dscSize * P.dscLead / 100 + 17) * u);
  root.style.setProperty('--avail', avail + 'px');

  /* ТИТУЛ ЗАНИМАЕТ ЭКРАН ЦЕЛИКОМ, а длину строки держит мера самого текста.
     Раньше по бокам стояли буферы: они не давали строке растянуться на широком
     экране, но на узком отбирали у титула ширину — и кегль, выведенный из неё,
     проваливался в нижнюю границу коридора ровно там, где смотрят чаще всего.
     Ограничивать длину строки должна мера, а не сосед: колонка титула равна
     экрану (значит титул по центру по построению, на любой ширине), а текст
     внутри неё не шире назначенного числа знаков. Кегль освободился и идёт
     модулем, как все остальные стили, внутри своего коридора. */

  ctx = {
    u: u, avail: avail, lab: lab, LAB: LAB,
    titleW: vw
  };

  cols.forEach(function (c) {
    if (!c.el.classList.contains('flow')) return;
    // первой строкой в колонке может стоять надстрочник — тогда и базовая
    // линия считается по его стилю, а не по стилю заголовка
    var stil = c.el.querySelector('.nad') ? 'cap'
             : c.el.querySelector('p.lead') ? 'lead'
             : c.el.querySelector('p.cap') ? 'cap' : 'main';
    c.pt = Math.round(ctx.LAB + bl.main - bl[stil]);
    c.el.style.paddingTop = c.pt + 'px';
    gauge(c);
  });
  cols.forEach(place);
  cols.forEach(function (c) { if (c.el.classList.contains('flow')) guard(c); });  // страховка на фрагментацию
  wins.forEach(function (w) { w.draw(); });
  maskaRezat();                                  // строки врезки — после ширин
  raskhod();
  // коробка оверлея вариантов: один замер за перекладку, в координатах ленты
  cols.forEach(function (c) {
    if (!c.vary) return;
    var r = korobka(c.vary);
    c.varBox = { l: r.left + strip.scrollLeft, t: r.top, w: r.width, h: r.height };
    c.varAkt = -2;
  });
  /* СТОПКА: где каждая картинка стоит в содержимом окна и какого она роста.
     Замер один за перекладку и в покое (П3) — в кадре из него только
     считается доля входа. Своя вертикаль есть только у стопки: одиночная
     картинка никуда по высоте не едет, её вход целиком горизонтальный. */
  katGryaz = true;                        // перекладка — копии каталога устарели
  cols.forEach(function (c) { c.katD = undefined; });
  cols.forEach(function (c) {
    c.raskrY = null;
    if (c.d.t !== 'figs' || !c.sc || !c.raskr.length) return;
    var r0 = korobka(c.sc), st = c.sc.scrollTop;
    c.okno = r0.height;
    c.raskrY = c.raskr.map(function (e) {
      var r = korobka(e);
      return { t: r.top - r0.top + st, h: r.height };
    });
  });
}

var ctx = null;

/* Одна колонка. Вынесено отдельно: когда колонка оживает под курсором,
   перекладывать всю ленту незачем — меняется она одна. */
function place(c) {
  if (!ctx) return;
  var d = c.d, e = c.el;
  e.style.height = '';
  e.style.setProperty('--room', '');
  var stavit = function (w) { c.w1 = Math.round(w); e.style.width = c.w1 + 'px'; };

  if (d.t === 'buffer') {
    stavit(COL);
    return;
  }
  if (d.t === 'title') {
    stavit(ctx.titleW);
    // кегль титула — модулем, внутри коридора в настоящих пикселах
    e.style.setProperty('--ttl',
      Math.max(P.ttl[0], Math.min(P.ttl[1], P.ttlSize * ctx.u)).toFixed(1) + 'px');
    return;
  }
  if (d.t === 'tabl') {                  // таблица шириной ровно в колонку
    stavit(COL);
    return;
  }
  if (d.t === 'fig') {
    var room = Math.max(60, ctx.avail - ctx.lab);
    stavit(figW(d.span, d.w, d.h, room));
    /* Окно ограничивается по высоте только в режиме прокрутки: в остальных
       картинка и так помещается, и полная высота окна отодвинула бы вниз
       всё, что стоит под ней, — линейку зон в первую очередь. */
    e.style.setProperty('--room', P.figFit === 'scroll' ? room + 'px' : '');
    return;
  }
  if (d.t === 'figs') {
    // окно стопки — вся высота колонки, но ширина считается по ОДНОЙ
    // картинке: у стопки с номером на каждой её долю ещё режет строка номера
    var box = Math.max(60, ctx.avail - (d.label === 'outside' ? ctx.lab : 0));
    var it = d.items[0];
    var one = Math.max(60, box - (d.label === 'each'
      ? Math.round((P.dscSize * P.dscLead / 100 + 18) * ctx.u) : 0));
    stavit(figW(d.span, it.w, it.h, one));
    e.style.setProperty('--room', box + 'px');
    return;
  }
  c.w1 = widthAt(spanFor(c));            // текстовая колонка: пролёт по высоте набора
  e.style.width = c.w1 + 'px';
}



/* Ширина картинки. Пролёт из макета — потолок, ниже него решает высота:
   картинка обязана помещаться в экран целиком, ради этого ей разрешено
   сойти с кратности («free»). «step» держит кратность и отступает целым
   пролётом — картинка целая, но мельче. «scroll» оставляет пролёт макета,
   а лишнее по высоте уходит в прокрутку колонки. */
function figW(sp, w, h, room) {
  var top = span(sp);
  if (P.figFit === 'scroll') return top;
  var fit = room * w / h;                 // ширина, при которой картинка влезает по высоте
  if (fit >= top) return top;
  return P.figFit === 'step' ? span(spanFits(fit)) : Math.max(60, Math.floor(fit));
}

/* абзац не влез по высоте — добираем пролёт, пока не влезет */
/* Сколько колонок займёт абзац. Раньше это решалось замером ширины прямо
   в момент раскладки — и ломалось, как только колонка росла: замер попадал
   в середину кривой роста. Теперь замер один — высота набора в одну
   колонку, снимается раз за перекладку, а число порций считается из неё:
   ceil(высота / высота экрана). */
function gauge(c) {
  var e = c.el;
  e.classList.add('gauge');          // одна колонка, высота по содержимому
  e.style.width = COL + 'px';
  c.h1 = e.offsetHeight - (c.pt || 0);   // без верхнего поля: только набор
  e.classList.remove('gauge');
}
function spanFor(c) {
  var mesto = Math.max(1, ctx.avail - (c.pt || 0));
  return Math.max(1, Math.min(8, Math.ceil((c.h1 || 1) / mesto)));
}
function widthAt(n) { return Math.round(n * COL + (n - 1) * GUT); }
/* РАСХОД ЛЕНТЫ. Позиции копятся вперёд по цепочке: левый край колонки —
   это сумма покойных мер и межколонников до неё. Считается раз за
   перекладку, в прокрутке геометрия не читается. */
function raskhod() {
  var acc = 0;
  stops = [];
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i];
    c.l = acc; c.rr = acc + c.w1;
    /* Точка, к которой ведёт адрес фрагмента. Пока она совпадает с левым
       краем колонки — титул занимает экран целиком и потому центрируется сам.
       Останется отдельной величиной: композиция блока может включать то, что
       стоит перед ним, и тогда якорь обязан вести к началу композиции. */
    c.yakor = c.l;
    if (c.el.id) stops.push({ id: c.el.id, l: c.l, r: c.rr, y: c.yakor });
    acc += c.w1 + GUT;
  }
  measure();
}
function yakorX(id) {
  for (var i = 0; i < stops.length; i++) if (stops[i].id === id) return stops[i].y;
  return null;
}

/* Страховка на фрагментацию: строка не рвётся пополам, поэтому колонок
   изредка нужно на одну больше расчёта. Проверяем сразу после раскладки. */
function guard(c) {
  var e = c.el, n = spanFor(c), g = 0;
  while (e.scrollWidth > e.clientWidth + 1 && n < 8 && g++ < 8) {
    n++; c.w1 = widthAt(n); e.style.width = c.w1 + 'px';
  }
}

function layoutMob(vw) {
  root.style.setProperty('--avail', 'auto');
  // поле ленты сбоку выводится из колонки, а не назначается вторым числом
  root.style.setProperty('--pole', ((vw - COL) / 2).toFixed(1) + 'px');
  // верхний пропуск держал буфер перед титулом; буфера нет — держит поле ленты
  root.style.setProperty('--gap-big', P.gapBig + 'px');
  wins.forEach(function (w) { w.draw(); });
  cols.forEach(function (c) {
    var d = c.d, e = c.el;
    e.style.width = '';
    if (d.t === 'buffer') {
      var h = ({ big: P.gapBig, mid: P.gapMid, sml: P.gapSml })[e.dataset.gap];
      e.style.height = h + 'px';
      e.style.setProperty('--gap-h', h + 'px');
      return;
    }
    e.style.height = '';
    e.style.paddingTop = '';        // место под индекс держал он сам — см. CSS выше
    e.style.setProperty('--room', '');
    if (d.t === 'title') {
      /* КЕГЛЬ ТИТУЛА В МОБАЙЛЕ УПИРАЕТСЯ В САМОЕ ДЛИННОЕ СЛОВО, а не в
         коридор. На десктопе титулу дан целый экран, и меру строки держит
         его мера в знаках; в мобайле дана одна колонка, переносить слово
         некуда — значит кегль сходит вниз ровно настолько, чтобы слово
         влезло, и ни на волос ниже. Ширина слова растёт с кеглем линейно
         (трекинг объявлен в em), поэтому доля «дано / надо» даёт ответ с
         одного захода. Замер один на раскладку, не в кадре (П3, то же
         исключение, что и у высоты набора). */
      var kegl = Math.max(P.ttl[0], Math.min(P.ttl[1], P.ttlSize * U));
      e.style.setProperty('--ttl', kegl.toFixed(1) + 'px');
      var h1 = e.querySelector('h1');
      if (h1) {
        var dano = h1.clientWidth, nado = h1.scrollWidth;
        if (nado > dano + 0.5 && dano > 0) {
          e.style.setProperty('--ttl',
            Math.max(9, kegl * dano / nado).toFixed(1) + 'px');
        }
      }
    }
  });
}

/* ПЕРЕНАБОР ТЕКСТА (приём 21 «Пропечатка», снят со стенда «Модульный
   алгоритмический лонгрид»). Перебор знаков живёт во времени, а собранностью
   правит ПОЛОЖЕНИЕ: доля набранного — функция того, насколько колонка вошла
   с правого края экрана. Поэтому набор идёт ровно тогда, когда текст
   приходит справа; колонка, входящая слева (ход назад), давно набрана и
   эффекта не получает — зона набора живёт у правого края, и только там.

   Несобранные буквы стоят неразрывными пробелами той же ширины, а настоящие
   пробелы остаются пробелами: в моноширинном наборе разбивка строк и высота
   колонки не меняются ни на кадр, поэтому перенабор не трогает раскладку.

   Перебор замирает, когда лента встала: движения нет — нет и перещёлкивания.
   Поэтому автономной анимации у стенда по-прежнему нет. */
/* АЛФАВИТ ПЕРЕБОРА. Регистр перебор наследует у самой буквы: строчная
   перещёлкивается строчными, прописная — прописными, цифра — цифрами.
   Иначе посреди строчного набора вспыхивает капс — шум, которого в
   материале нет. Регистр здесь не параметр, а свойство материала.

   А вот АЛФАВИТ — параметр, и в этом весь ход. Перебирать кириллицу
   кириллицей значит показывать опечатки: глаз читает несобранное слово как
   ошибку набора. Перебор латиницей читается иначе — машинным шумом, из
   которого собирается человеческий текст, и это ровно то, о чём статья.
   Английской ленте разницы нет, русской — вся. Ручка «Перебирать
   латиницей». Ширина не страдает: в моноширинном наборе латинская буква
   той же меры, что кириллическая.

   Знаки препинания перебор не трогает вовсе: скобка, сменившаяся другой,
   читается как опечатка, а не как набор. */
var ALF = {
  lat: { lo: 'abcdefghijklmnopqrstuvwxyz', up: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' },
  kir: { lo: 'абвгдежзийклмнопрстуфхцчшщэюя', up: 'АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЭЮЯ' }
};
var CIFRY = '0123456789';
var ZNAKI = '.,;:!?—–-()“”’/*+#';
function flapChar(ch, n) {
  var lo = ch.toLowerCase(), up = ch.toUpperCase();
  if (lo === up) return ch >= '0' && ch <= '9'
    ? CIFRY[n % 10] : ZNAKI[n % ZNAKI.length];
  var code = ch.charCodeAt(0);
  // алфавит перебора: латиница вместо своего — машинный шум вместо опечатки
  var a = (!flag(P.naborLat) && code >= 0x400 && code <= 0x4FF) ? ALF.kir : ALF.lat;
  var set = (ch === up) ? a.up : a.lo;
  return set[n % set.length];
}
var NBSP = '\u00A0';
/* Неразрывный пробел для перенабора — такой же пробел, как обычный: иначе
   он попал бы под перещёлк и связка предлога рассыпалась бы буквами. */
function probel(ch) {
  return ch === ' ' || ch === '\n' || ch === '\u2028' || ch === NBSP;
}

/* ВИСЯЧИЕ ПРЕДЛОГИ. Правило русского набора: короткое служебное слово не
   остаётся в конце строки одно, а уходит на следующую вместе со своим.
   Разбирается это неразрывным пробелом и никакой разметки не требует.

   Связок четыре, и все они правила набора, а не вкус:
     предлог, союз, частица в одну–три буквы липнет к следующему слову;
     число не отрывается от того, что считает («12 колонок», «с. 74»);
     тире не начинает строку — держится за слово перед собой;
     инициалы не отрываются от фамилии.
   Проход делается дважды: цепочка «и в этом» связывается за два шага,
   а больше двух коротких слов подряд в тексте почти не встречается. */
var KOROTKIE = ('а,и,но,да,же,ли,бы,б,ж,не,ни,в,во,на,над,под,по,из,изо,от,ото,' +
  'до,за,к,ко,с,со,у,о,об,обо,для,при,про,без,как,что,чем,или,то,так,уж,' +
  'их,его,её,мы,вы,он,я,ты,те,та,тот,эта,это,тем,том,той,был,вот').split(',');
function typograf(s) {
  if (typeof s !== 'string' || !/[А-Яа-яЁё]/.test(s)) return s;
  for (var proh = 0; proh < 2; proh++) {
    // за коротким словом может стоять и латиница: «в XX веке», «на Mac»
    s = s.replace(/(^|[\s(«„"—–-])([А-Яа-яЁё]{1,3})[ ]+(?=[А-Яа-яЁёA-Za-z0-9«„"])/g,
      function (m, do_, sl) {
        return KOROTKIE.indexOf(sl.toLowerCase()) < 0 ? m : do_ + sl + NBSP;
      });
  }
  s = s.replace(/(\d)[ ]+(?=[А-Яа-яЁё])/g, '$1' + NBSP);       // число и его слово
  s = s.replace(/([№§])[ ]+(?=\d)/g, '$1' + NBSP);              // знак и номер
  s = s.replace(/[ ]+([—–])[ ]/g, NBSP + '$1 ');                 // тире держится за слово
  s = s.replace(/([А-ЯЁ]\.)[ ]*([А-ЯЁ]\.)[ ]*(?=[А-ЯЁ])/g,
                '$1' + NBSP + '$2' + NBSP);                      // инициалы
  s = s.replace(/([А-ЯЁ]\.)[ ]+(?=[А-ЯЁ][а-яё])/g, '$1' + NBSP);
  return s;
}
function jit(seed, i) {
  var x = Math.sin(seed * 37.7 + i * 13.31) * 43758.545;
  return x - Math.floor(x);
}
function flapText(target, seed, p, tick, win) {
  if (p >= 1) return target;
  var L = target.length, out = '';
  for (var i = 0; i < L; i++) {
    var ch = target[i];
    if (probel(ch)) { out += ch; continue; }
    var t = (i + jit(seed, i) * 2.2) / (L + 2.2);   // порог буквы: слева направо, с дрожью
    // знаки препинания перебор не трогает: скобка, сменившаяся другой,
    // читается как опечатка, а не как набор
    var znak = ch.toLowerCase() === ch.toUpperCase() && !(ch >= '0' && ch <= '9');
    if (p >= t) out += ch;
    else if (p > 0 && t - p < win) out += znak ? ch : flapChar(ch, tick + i * 7 + seed * 3);
    else out += znak ? ch : NBSP;
  }
  return out;
}
/* ВЫЕЗД ВРЕЗКИ ИЗ-ПОД МАСКИ (модуль /panel-lib/maska.js, снят с
   kononenkogroup.com). Тело статьи перенабирается, врезка выезжает: два
   разных появления по одному закону — доля считается от того, насколько
   колонка вошла с правого края. Строки режутся заново после каждой
   перекладки: разбивка зависит от ширины, а её знает только браузер. */
function maskaRezat() {
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i];
    if (c.d.t === 'title') {
      // титул режется целиком: дата и заголовок — одна последовательность строк
      var d1 = c.el.querySelector('.idx'), h1 = c.el.querySelector('h1');
      if (mobile) { StendMaska.snyat(d1); StendMaska.snyat(h1); c.maska = null; continue; }
      c.maska = StendMaska.rezat(d1).concat(StendMaska.rezat(h1));
      continue;
    }
    var e = c.el.querySelector('p.lead');
    if (!e) { c.maska = null; continue; }
    c.maska = (mobile || !P.maskaPath) ? (StendMaska.snyat(e), null) : StendMaska.rezat(e);
  }
}
/* ТИТУЛ: приходит снизу при заходе, уходит наверх у левого края.
   Две фазы одной маски. Появление живёт временем — оно случается один раз,
   при заходе на страницу, и положением его не задать. Уход живёт положением:
   как только левый край колонки титула коснулся левого края экрана, строки
   начинают уходить вверх и уходят за назначенный путь; ход назад возвращает
   их сверху вниз тем же законом. Сторона маски и есть разница между этими
   фазами: приходят снизу, уходят вверх. */
function maskaTtl(vw, sl) {
  var c = null;
  for (var i = 0; i < cols.length; i++) if (cols[i].d.t === 'title') c = cols[i];
  if (!c || !c.maska) return;
  var levo = c.l - sl;
  // в каталоге лента уведена далеко вправо, и уход титула наверх там ни при
  // чём: строка обязана показывать титул целиком
  var vyhod = (katK > 0 || !P.ttlPath || levo >= 0) ? 1 : Math.max(0, 1 + levo / P.ttlPath);
  var vhod = (TIHO || !P.ttlMs) ? 1
    : Math.min(1, (performance.now() - T0) / P.ttlMs);
  StendMaska.pokazat(c.maska, Math.min(vhod, vyhod), {
    sdvig: P.maskaSdvig / 100,
    storona: vyhod < 1 ? 'sverh' : 'sniz',
    izing: function (q) { return evalEase(P.maskaEase, P.maskaBez, q); }
  });
}

function maska() {
  if (mobile) return;
  var vw = window.innerWidth, sl = strip.scrollLeft;
  maskaTtl(vw, sl);
  if (!P.maskaPath) return;
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i];
    if (!c.maska || c.d.t === 'title') continue;
    var p = TIHO ? 1 : (vw - (c.l - sl)) / P.maskaPath;
    p = p < 0 ? 0 : p > 1 ? 1 : p;
    StendMaska.pokazat(c.maska, p, {
      sdvig: P.maskaSdvig / 100,
      izing: function (q) { return evalEase(P.maskaEase, P.maskaBez, q); }
    });
  }
}

/* ПАМЯТЬ СТОПКИ. Колонка со стопкой держит своё положение по вертикали,
   только пока её видно. Ушла за край экрана целиком — забыла и встала на
   начало: вернувшись к ней, читатель встречает стопку такой, какой увидел
   её впервые, а не там, где бросил.

   Забывание идёт по положению, как и всё остальное: колонка ушла, когда её
   правый край левее левого края экрана — или левый край правее правого — на
   запас. Запас берётся долей колонки, а не пикселами: ширина колонки —
   объявленный модуль, и мера ухода живёт в нём же.

   Раскрытию отдельного правила не нужно: оно считается от положения, и
   вернувшаяся колонка сама покажет первую картинку целой, а остальные под
   маской. Сброс случается за краем, поэтому его никто не видит — движения
   здесь нет, и кривая ему не нужна. */
function stopkaPamyat() {
  if (mobile || !flag(P.stopSbros)) return;
  var vw = window.innerWidth, sl = strip.scrollLeft;
  var zapas = COL * P.stopZapas / 100;
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i];
    if (c.d.t !== 'figs' || !c.sc || !c.sc.scrollTop) continue;
    if (c.rr - sl < -zapas || c.l - sl > vw + zapas) c.sc.scrollTop = 0;
  }
}

/* мобайл: раскрытия там нет — снять маски, иначе картинка,
   застигнутая срезанной, такой и останется // без ручки */
function raskrSnyat() {
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i];
    if (!c.raskr) continue;
    for (var k = 0; k < c.raskr.length; k++) {
      if (c.raskrQ[k] === 1) continue;
      c.raskr[k].style.clipPath = ''; c.raskrQ[k] = 1;
    }
  }
}

/* РАСКРЫТИЕ КАРТИНКИ (снято с показа Сергея в Фигме, 2026-08-25).
   Картинка приходит не целиком: она открывается сверху вниз из-под маски —
   содержимое стоит в натуральную величину, вниз едет нижний край маски.
   Режет clip-path, а не высота коробки: высота в потоке не меняется,
   поэтому раскрытие не двигает соседей и не дёргает ход стопки.

   ДОЛЯ — ОТ СВОЕГО ВХОДА (2026-08-25). Раньше доля была одна на колонку:
   насколько колонка вошла с правого края. В стопке это значило, что пятая
   картинка открыта ровно так же, как первая, хотя её ещё не видели.
   Теперь картинка смотрит на СВОЙ вход в поле зрения, и ось та, по которой
   она едет. Их две, и обе живут одновременно:
     горизонталь — колонка приезжает справа, доля общая на всю колонку,
       путь в пикселах хода ленты («Картинка: путь раскрытия, px»);
     вертикаль — внутри стопки картинка поднимается снизу в своём окне,
       доля у каждой своя, путь выведен из неё самой — собственный рост,
       ограниченный высотой окна: больше окно пройти и не даёт. На 100 %
       картинка открыта ровно к тому мгновению, когда вошла в окно целиком
       («Стопка: путь раскрытия, %» правит эту долю роста).
   Открыта настолько, насколько вошла: решает МЕНЬШАЯ из двух долей — тот
   вход, который ещё не закончился, и держит. Одиночная картинка по высоте
   никуда не едет, вертикали у неё нет, и закон для неё прежний. */
function raskrytie() {
  if (mobile) return raskrSnyat();
  var vw = window.innerWidth, sl = strip.scrollLeft;
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i];
    if (!c.raskr || !c.raskr.length) continue;
    // вход по горизонтали: один на всю колонку
    var pg = (TIHO || !P.fotoPath) ? 1 : (vw - (c.l - sl)) / P.fotoPath;
    pg = pg < 0 ? 0 : pg > 1 ? 1 : pg;
    var vert = !TIHO && P.stopPut && c.raskrY && c.okno > 0;
    var st = vert ? c.sc.scrollTop : 0;
    for (var k = 0; k < c.raskr.length; k++) {
      var p = pg;
      if (vert) {                       // вход по вертикали: у каждой свой
        var b = c.raskrY[k];
        var put = Math.min(b.h, c.okno) * P.stopPut / 100;
        var pv = put > 0 ? (c.okno - (b.t - st)) / put : 1;
        if (pv < p) p = pv < 0 ? 0 : pv;
      }
      var q = evalEase(P.fotoEase, P.fotoBez, p);
      if (q === c.raskrQ[k]) continue;
      c.raskrQ[k] = q;
      c.raskr[k].style.clipPath =
        q >= 1 ? '' : 'inset(0 0 ' + ((1 - q) * 100).toFixed(2) + '% 0)';
    }
  }
}

/* Какая доля поля под курсором — та и показана. Считается по положению,
   как и всё остальное в стенде: событий наведения на зоны нет, есть точка
   и поле, поделённое на доли. */
function varyTick() {
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i];
    if (!c.vary || !c.varBox) continue;
    var akt = -1;
    if (!mobile && mx != null) {
      // коробка снята раз за перекладку в координатах ленты; здесь только счёт
      var b = c.varBox, x = mx + strip.scrollLeft, n = c.vary.children.length;
      if (x >= b.l && x <= b.l + b.w && my >= b.t && my <= b.t + b.h && b.w > 0) {
        akt = Math.min(n - 1, Math.floor((x - b.l) / (b.w / n)));
      }
    }
    if (akt === c.varAkt) continue;
    c.varAkt = akt;
    for (var k = 0; k < c.vary.children.length; k++) {
      c.vary.children[k].classList.toggle('on', k === akt);
    }
  }
}

function nabor() {
  if (TIHO) {                       // «меньше движения»: текст стоит набранным
    for (var t = 0; t < cols.length; t++) {
      var q = cols[t];
      if (q.txtEl && q.shown !== q.txt) { q.txtEl.textContent = q.txt; q.shown = q.txt; }
      if (q.dsc) q.dsc.forEach(function (dd) {
        if (dd.shown !== dd.txt) { dd.el.textContent = dd.txt; dd.shown = dd.txt; }
      });
      if (q.foto && q.fotoY) { q.foto.style.transform = ''; q.fotoY = 0; }
    }
    return;
  }
  if (mobile || !P.naborPath) return;
  var vw = window.innerWidth, sl = strip.scrollLeft;
  var tick = Math.floor(performance.now() / Math.max(20, P.naborTick));
  var win = P.naborFront / 100;
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i];
    if (!c.txtEl) continue;
    var p = (vw - (c.l - sl)) / P.naborPath;
    p = p < 0 ? 0 : p > 1 ? 1 : p;
    if (P.naborLatch && c.pn === 1) p = 1;
    // перещёлк замирает, когда доля перестала меняться: движения нет — нет перебора
    if (p === c.pn) { if (c.hold < 20) c.hold++; } else { c.hold = 0; c.pn = p; }
    if (c.hold < 20) c.tick = tick;
    // колонка набралась и идёт вспышка — узел ведёт она, набор в него не пишет:
    // иначе двое пишут в один textContent каждый кадр и защита c.shown слепнет
    if (p >= 1 && vspZhivo) continue;
    var out = p >= 1 ? c.txt : flapText(c.txt, c.i, p, c.tick, win);
    if (out !== c.shown) { c.txtEl.textContent = out; c.shown = out; }
  }
  naborDsc(tick, win);
}

/* ВСПЫШКА ПЕРЕБОРА (2026-08-25). Тот же перебор знаков, что и при входе
   колонки, обыгранный иначе: не приход текста, а его встряска на ходу.

   ТРИГГЕР — переход ленты ПОКОЙ → ДВИЖЕНИЕ. Стенд уже знает это состояние,
   им живут два скролла; вспышка садится на его перелом. Одна вспышка на
   жест: лента встала и поехала снова — новая выборка. Заход в страницу
   вспышки не даёт (edWas стартует поднятым): проезд к адресу фрагмента —
   не жест читателя.

   ВЫБОРКА. Слово выбрано, если jit(зерно, номер слова) < порога. Зерно —
   пара «номер вспышки × номер колонки», поэтому каждый жест раздаёт словам
   новые числа: выглядит случайно, каждый раз другое, и при этом
   воспроизводится. Случайности в стенде нет, есть счёт. Доля берётся от
   слов ВСЕЙ колонки, а не видимой её части: колонка — целое, даже когда
   перетекла в соседнюю.

   ЗАТУХАНИЕ. Порог = доля × (1 − кривая(прогресс)). В начале перебирается
   вся назначенная доля, к концу — ни одного, и слова возвращаются в текст
   по очереди своего хеша, а не все разом. Последний проход идёт с порогом
   ноль: он и собирает текст обратно, после чего вспышка засыпает и кадр
   больше не тратится.

   БЕЗ СДВИГА. Буква меняется на букву своего регистра и алфавита, цифра на
   цифру, длина слова та же — моноширинный набор не переезжает ни на кадр.
   Знаки препинания не трогаются вовсе: дефис, сменившийся точкой, убрал бы
   место переноса, и строка могла бы уехать. Перебор обязан быть без сдвига,
   иначе он трогает раскладку и ломает сопряжение по базовой линии. */
var vspN = 0, vspT0 = 0, vspZhivo = false, edWas = true;

/* границы слов: непробельные куски строки // без ручки */
function slovaIz(t) {
  var w = [], i = 0, n = t.length;
  while (i < n) {
    while (i < n && probel(t[i])) i++;
    var a = i;
    while (i < n && !probel(t[i])) i++;
    if (i > a) w.push([a, i]);
  }
  return w;
}

/* Строка колонки с выбранными словами в переборе: трогаются только
   выбранные куски, остальное берётся ломтями исходника. */
function vspSobrat(c, porog, tk, seed) {
  var w = c.slova, t = c.txt, out = '', pos = 0;
  for (var j = 0; j < w.length; j++) {
    if (jit(seed, j) >= porog) continue;
    var a = w[j][0], b = w[j][1];
    out += t.slice(pos, a);
    for (var k = a; k < b; k++) {
      var ch = t[k];
      var znak = ch.toLowerCase() === ch.toUpperCase() && !(ch >= '0' && ch <= '9');
      // Подмена берётся хешем, а не шагом по алфавиту: линейный шаг на целом
      // слове читается одним и тем же шифром — «bipwdk» в каждом слове.
      out += znak ? ch : flapChar(ch, tk + Math.floor(jit(seed + j, k) * 997));
    }
    pos = b;
  }
  return pos ? out + t.slice(pos) : t;
}

function vspyshka() {
  if (mobile) { vspZhivo = false; return; }
  var now = performance.now();
  var edet = !!ride || cur !== tgt;
  if (edet && !edWas) { vspN++; vspT0 = now; vspZhivo = !TIHO; }
  edWas = edet;
  if (!vspZhivo) return;
  // ручку увели в ноль посреди вспышки — доводим прогресс до конца и собираем
  var q = (!P.vspDolya || !P.vspMs) ? 1 : (now - vspT0) / P.vspMs;
  if (q >= 1) { q = 1; vspZhivo = false; }
  var porog = P.vspDolya / 100 * (1 - evalEase(P.vspEase, P.vspBez, q));
  var vw = window.innerWidth, sl = strip.scrollLeft;
  var tk = Math.floor(now / Math.max(20, P.vspTick));
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i];
    if (!c.txtEl || !c.slova || !c.slova.length) continue;
    // колонка ещё набирается входом — узел не наш, его ведёт nabor()
    var pin = P.naborPath ? (vw - (c.l - sl)) / P.naborPath : 1;
    if (pin < 1) continue;
    // за краем экрана перебирать нечего, но собрать обратно надо: колонка
    // могла уехать влево посреди вспышки и осталась бы рассыпанной
    var vidno = c.l - sl < vw && c.rr - sl > 0;
    var out = (vidno && porog > 0) ? vspSobrat(c, porog, tk, vspN * 101 + c.i) : c.txt;
    if (out !== c.shown) { c.txtEl.textContent = out; c.shown = out; }
  }
}

/* Дескрипторы перебираются тем же законом. Их доля считается по колонке,
   в которой они стоят, — у колонок без тела статьи она своя. Картинка под
   подписью идёт сверху вниз: пока текст пересобирается, она доезжает до
   своего места, а не стоит готовой над несобранным. */
function naborDsc(tick, win) {
  if (!flag(P.naborDsc)) return;
  var vw = window.innerWidth, sl = strip.scrollLeft;
  for (var i = 0; i < cols.length; i++) {
    var c = cols[i];
    if (!c.dsc || !c.dsc.length) continue;
    var p = (vw - (c.l - sl)) / P.naborPath;
    p = p < 0 ? 0 : p > 1 ? 1 : p;
    for (var k = 0; k < c.dsc.length; k++) {
      var dd = c.dsc[k];
      var out = p >= 1 ? dd.txt : flapText(dd.txt, c.i * 7 + k * 3, p, c.tick, win);
      if (out !== dd.shown) { dd.el.textContent = out; dd.shown = out; }
    }
    if (c.foto) {
      var y = (1 - p) * -P.naborFoto;
      if (c.fotoY !== y) {
        c.foto.style.transform = y ? 'translate3d(0,' + y.toFixed(1) + '%,0)' : '';
        c.fotoY = y;
      }
    }
  }
}

/* ── ход ленты ───────────────────────────────────────────────────────
   Две динамики. Колесо ведёт ленту догоном: цель прыгает, лента идёт за
   ней с экспоненциальным отставанием (приём 15, у догона нет начала и
   конца — там работает отставание, кривая неуместна). Клавиши, переход
   по адресу фрагмента и притяжение к колонке — проезд: у него есть
   начало и конец, поэтому он едет по кривой из слота панели. */
var EASES = {
  'линейный': function (t) { return t; },
  'разгон': function (t) { return t * t * t; },
  'торможение': function (t) { return 1 - Math.pow(1 - t, 3); },
  'плавный': function (t) { return t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; },
  'квадрат': function (t) { return t * t; }
};
var BEZ_APPROX = {
  'линейный': [0.25, 0.25, 0.75, 0.75],
  'разгон': [0.32, 0, 0.67, 0],
  'торможение': [0.33, 1, 0.68, 1],
  'плавный': [0.65, 0, 0.35, 1],
  'квадрат': [0.45, 0, 0.75, 0.3]
};
function cubicBezierY(b, t) {
  var x1 = b[0], y1 = b[1], x2 = b[2], y2 = b[3], sT = t;
  for (var i = 0; i < 8; i++) {
    var x = 3 * (1 - sT) * (1 - sT) * sT * x1 + 3 * (1 - sT) * sT * sT * x2 + sT * sT * sT;
    var dx = 3 * (1 - sT) * (1 - sT) * x1 + 6 * (1 - sT) * sT * (x2 - x1) + 3 * sT * sT * (1 - x2);
    if (Math.abs(dx) < 1e-6) break;
    sT -= (x - t) / dx;
    if (sT < 0) sT = 0; if (sT > 1) sT = 1;
  }
  return 3 * (1 - sT) * (1 - sT) * sT * y1 + 3 * (1 - sT) * sT * sT * y2 + sT * sT * sT;
}
function evalEase(name, bez, t) {
  if (t <= 0) return 0;
  if (t >= 1) return 1;
  if (name === 'bezier') return cubicBezierY(bez, t);
  return (EASES[name] || EASES['плавный'])(t);
}

var cur = 0, tgt = 0, raf = 0, ride = null;
var lastPush = 0;          // когда ленту последний раз вели вбок
var mx = null, my = null;  // где стоит курсор
var liveCol = null;        // колонка под курсором, которая ожила

function tick() {
  if (ride) {
    var p = P.ride > 0 ? (performance.now() - ride.t0) / P.ride : 1;
    if (p >= 1) { cur = tgt = ride.to; ride = null; }
    else cur = ride.from + (ride.to - ride.from) * evalEase(P.rideEase, P.rideBez, p);
  } else {
    var k = TIHO ? 1 : 1 - P.lag / 100;
    cur += (tgt - cur) * (k <= 0 ? 1 : k);
    if (Math.abs(tgt - cur) < 0.5) cur = tgt;
  }
  strip.scrollLeft = cur;
  if (ride || cur !== tgt) { raf = requestAnimationFrame(tick); return; }
  raf = 0;
  if (flag(P.snap)) snap();
}
function run() { if (!raf) raf = requestAnimationFrame(tick); }
function maxScroll() { return Math.max(0, strip.scrollWidth - strip.clientWidth); }
function hold(x) { return Math.max(0, Math.min(maxScroll(), x)); }
function push(dx) { ride = null; lastPush = performance.now(); tgt = hold(tgt + dx); run(); }
function rideTo(x) {
  x = hold(x); lastPush = performance.now(); tgt = x;
  if (TIHO || !P.ride) { ride = null; cur = x; strip.scrollLeft = cur; measure(); return; }
  ride = { from: cur, to: x, t0: performance.now() }; run();
}

/* Пока лента едет, колонки с картинками пролетают мимо: колесо остаётся
   горизонтальным, даже если курсор пересёк такую колонку. Вертикаль в
   колонке просыпается только на остановке — лента стоит, пауза после
   последнего хода вбок больше «wake», курсор на этой колонке. Первый же
   ход вбок снова её усыпляет. Читателя не разворачивает посреди движения:
   переключение стало намерением, а не случайностью. */
function rested() {
  return !ride && cur === tgt && performance.now() - lastPush >= P.wake;
}
/* Колонку под курсором ищем попаданием точки, а не запоминаем по наведению:
   лента едет под неподвижным курсором, и запомненное окно тут же врёт. */
/* Колонка под курсором. Ищется не попаданием в саму колонку, а по оси
   ленты: между колонками лежит межколонник, над ним нет ни одной колонки,
   и курсор там проваливался в пустоту — колонка гасла на полпути к соседу.
   Межколонник делится пополам, каждая половина принадлежит своей колонке;
   пустых мест над лентой не остаётся, а сам межколонник не трогаем. */
function colAt() {
  if (mx == null || mobile) return null;
  var hit = document.elementFromPoint(mx, my);
  if (hit && hit.closest && (hit.closest('.st-panel') || hit.closest('.st-gear'))) return null;
  var x = mx + strip.scrollLeft, half = GUT / 2;
  for (var i = 0; i < cols.length; i++) {
    if (x >= cols[i].l - half && x <= cols[i].rr + half) return cols[i].el;
  }
  return null;
}
function live(c) { return liveCol === c.el; }
function awake(sc) {
  return rested() && !!liveCol && liveCol.contains(sc);
}

strip.addEventListener('wheel', function (e) {
  if (mobile) return;
  if (e.target.closest && e.target.closest('.st-panel')) return;   // панель скроллится сама
  // колесо шлёт пиксели, строки (deltaMode 1) или экраны (2) — сводим к пикселям // без ручки
  var kx = e.deltaMode === 1 ? 100 / 6 : e.deltaMode === 2 ? innerWidth : 1;
  var ky = e.deltaMode === 1 ? 100 / 6 : e.deltaMode === 2 ? innerHeight : 1;
  var dx = e.deltaX * kx, dy = e.deltaY * ky;
  if (katK > 0) {                       // в каталоге колесо листает статьи
    e.preventDefault();
    katSdvig = Math.max(0, Math.min(katMax(), katSdvig + (Math.abs(dy) >= Math.abs(dx) ? dy : dx)));
    return;
  }
  var sc = e.target.closest && e.target.closest('.scroller');
  if (sc && awake(sc) && Math.abs(dy) >= Math.abs(dx)) {
    var top = sc.scrollTop <= 0, bot = sc.scrollTop >= sc.scrollHeight - sc.clientHeight - 1;
    if ((dy < 0 && !top) || (dy > 0 && !bot)) return;  // вертикаль внутри колонки
  }
  e.preventDefault();
  var d = Math.abs(dx) > Math.abs(dy) ? dx : dy;
  push(d * P.wheel / 100);
}, { passive: false });

document.addEventListener('pointermove', function (e) { mx = e.clientX; my = e.clientY; });
document.addEventListener('pointerleave', function () { mx = my = null; });

strip.addEventListener('scroll', function () {
  if (Math.abs(strip.scrollLeft - cur) > 2) { cur = tgt = strip.scrollLeft; }
  measure();
});

function snap() {
  var best = null, bd = 1e9;
  stops.forEach(function (st) {
    var d = Math.abs(st.l - cur);
    if (d < bd) { bd = d; best = st.l; }
  });
  if (best != null && bd > 1 && bd < COL) rideTo(best);
}

window.addEventListener('keydown', function (e) {
  if (mobile || (e.target && /INPUT|TEXTAREA|SELECT/.test(e.target.tagName))) return;
  var step = window.innerWidth * 0.9;
  if (e.key === 'ArrowRight' || e.key === 'PageDown') { rideTo(cur + step); e.preventDefault(); }
  else if (e.key === 'ArrowLeft' || e.key === 'PageUp') { rideTo(cur - step); e.preventDefault(); }
  else if (e.key === 'Home') { rideTo(0); e.preventDefault(); }
  else if (e.key === 'End') { rideTo(maxScroll()); e.preventDefault(); }
});

